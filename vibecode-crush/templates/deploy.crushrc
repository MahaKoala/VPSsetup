#!/usr/bin/env bash
# Opt-in GitHub MCP. Prefer least-privilege short-lived credentials.
if [[ -n "${GITHUB_TOKEN:-}" ]] && command -v docker >/dev/null 2>&1; then
  mcp add github --command docker --args "run" --args "-i" --args "--rm" \
    --args "-e" --args "GITHUB_PERSONAL_ACCESS_TOKEN" \
    --args "ghcr.io/github/github-mcp-server" \
    --env GITHUB_PERSONAL_ACCESS_TOKEN "$GITHUB_TOKEN"
fi
# Add other deployment services (Vercel, Cloudflare, Neon, Supabase,
# Sentry) on a project basis after checking their current OAuth endpoints.
