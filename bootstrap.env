# ------------------------------------------------------------------
# VPS bootstrap configuration. Override via cloud-init write_files
# or by exporting variables before running the scripts.
# ------------------------------------------------------------------

# --- Identity ---
VPS_USER="${VPS_USER:-maha}"
VPS_USER_SHELL="${VPS_USER_SHELL:-/bin/bash}"
FIRST_LOGIN_PASSWORD_PROMPT="${FIRST_LOGIN_PASSWORD_PROMPT:-0}"  # 0 = SSH-key-only, no password hook
VPS_HOSTNAME="${VPS_HOSTNAME:-}"                # empty -> auto/keep
VPS_HOSTNAME_PREFIX="${VPS_HOSTNAME_PREFIX:-deployeddigital}"
VPS_ROLE="${VPS_ROLE:-dev}"
VPS_SETUP_REF="${VPS_SETUP_REF:-main}"                 # staging | production | dev

# --- SSH key sources (any/all) ---
SSH_ID="${SSH_ID:-}"                            # https://sshid.io/<id>
SSH_ID_TYPED_KEYS="${SSH_ID_TYPED_KEYS:-RSA ECDSA-SK}"  # optional typed endpoints, warn on 404
SSH_GH_USER="${SSH_GH_USER:-}"                  # https://github.com/<u>.keys
SSH_AUTHORIZED_KEYS="${SSH_AUTHORIZED_KEYS:-}"  # raw, newline-separated

# --- Sudo ---
ENABLE_PASSWORDLESS_SUDO="${ENABLE_PASSWORDLESS_SUDO:-1}"
INSTALL_TOOLS="${INSTALL_TOOLS:-0}"

# --- Optional Crush vibe-coding worker (never installed by default) ---
INSTALL_VIBECODE_CRUSH="${INSTALL_VIBECODE_CRUSH:-0}"
CRUSH_MCP_PROFILE="${CRUSH_MCP_PROFILE:-core}"  # none | core | extended
CRUSH_LSP_PROFILE="${CRUSH_LSP_PROFILE:-web,python}"  # web,python,go,rust,none
CRUSH_INSTALL_ROOT="${CRUSH_INSTALL_ROOT:-0}"  # root config opt-in
CRUSH_CONFIG_ONLY="${CRUSH_CONFIG_ONLY:-0}"
CRUSH_OVERWRITE_COMMANDS="${CRUSH_OVERWRITE_COMMANDS:-0}"
CRUSH_INSTALL_BIN="${CRUSH_INSTALL_BIN:-1}"

# DeepSeek Super-Agent is an experimental separate harness, never a Crush model.
STAGE_DEEPSEEK_SUPERAGENT="${STAGE_DEEPSEEK_SUPERAGENT:-0}"
DEEPSEEK_SUPERAGENT_REF="${DEEPSEEK_SUPERAGENT_REF:-main}"


# --- Homebrew + tooling ---
INSTALL_BREW="${INSTALL_BREW:-0}"
INSTALL_BREW_PACKAGES="${INSTALL_BREW_PACKAGES:-0}"
BREW_PACKAGES="${BREW_PACKAGES:-starship eza tldr zoxide btop fd ripgrep bat git-delta lazygit glow ranger jq yq fzf gh node oven-sh/bun/bun pnpm yarn go}"
INSTALL_NODE_LTS="${INSTALL_NODE_LTS:-0}"        # 0 because we install node via brew
INSTALL_DOCKER="${INSTALL_DOCKER:-0}"
NVM_VERSION="${NVM_VERSION:-v0.40.3}"

# --- RAM-aware swap, independent of cloud-init ---
SWAP_MODE="${SWAP_MODE:-auto}"
SWAP_PERCENT="${SWAP_PERCENT:-50}"
SWAP_MIN_MB="${SWAP_MIN_MB:-512}"
SWAP_MAX_MB="${SWAP_MAX_MB:-4096}"
SWAP_DISK_RESERVE_MB="${SWAP_DISK_RESERVE_MB:-1024}"
SWAP_FILE="${SWAP_FILE:-/swapfile}"

# --- SSH hardening ---
SSH_PORT="${SSH_PORT:-22}"
HARDEN_SSH="${HARDEN_SSH:-1}"
ALLOW_PASSWORD_AUTH="${ALLOW_PASSWORD_AUTH:-no}"
PERMIT_ROOT_LOGIN="${PERMIT_ROOT_LOGIN:-prohibit-password}"
LIMIT_SSH_TO_ADMIN_USER="${LIMIT_SSH_TO_ADMIN_USER:-1}"
DISABLE_IPV6_SSH="${DISABLE_IPV6_SSH:-0}"

# --- Firewall / fail2ban / updates / sysctl ---
ENABLE_UFW="${ENABLE_UFW:-1}"
PUBLIC_SSH_ALLOWED="${PUBLIC_SSH_ALLOWED:-1}"
TAILNET_SSH_VERIFIED="${TAILNET_SSH_VERIFIED:-0}"  # set to 1 only after a separate successful tailnet SSH session
ALLOW_HTTP_HTTPS="${ALLOW_HTTP_HTTPS:-0}"
EXTRA_UFW_PORTS="${EXTRA_UFW_PORTS:-}"          # e.g. "8080/tcp 5432/tcp"
ENABLE_FAIL2BAN="${ENABLE_FAIL2BAN:-1}"
ENABLE_UNATTENDED="${ENABLE_UNATTENDED:-1}"
UNATTENDED_AUTOREBOOT="${UNATTENDED_AUTOREBOOT:-true}"
UNATTENDED_AUTOREBOOT_TIME="${UNATTENDED_AUTOREBOOT_TIME:-03:30}"
ENABLE_SYSCTL_HARDENING="${ENABLE_SYSCTL_HARDENING:-1}"
DISABLE_IPV6="${DISABLE_IPV6:-0}"

# --- Tailscale ---
INSTALL_TAILSCALE="${INSTALL_TAILSCALE:-1}"
TAILSCALE_AUTHKEY="${TAILSCALE_AUTHKEY:-}"      # tskey-auth-...
TAILSCALE_HOSTNAME="${TAILSCALE_HOSTNAME:-}"    # default = $VPS_HOSTNAME
TAILSCALE_TAGS="${TAILSCALE_TAGS:-}"            # blank = use the tags baked into the auth key. Override with --advertise-tags only when every tag is also declared in tailscale.json's tagOwners
TAILSCALE_SSH="${TAILSCALE_SSH:-1}"
TAILSCALE_ACCEPT_DNS="${TAILSCALE_ACCEPT_DNS:-false}"
TAILSCALE_ADVERTISE_ROUTES="${TAILSCALE_ADVERTISE_ROUTES:-}"
TAILSCALE_EXIT_NODE="${TAILSCALE_EXIT_NODE:-0}"
TAILSCALE_EXTRA_ARGS="${TAILSCALE_EXTRA_ARGS:---accept-routes}"